{
  "manifest_version": 3,
  "name": "LLM Cliché Highlighter",
  "version": "1.0.0",
  "description": "Highlights LLM clichés on the current page; click again to remove. Port of Simon Willison's llm-cliche-highlighter (Apache-2.0).",
  "action": {
    "default_title": "Highlight LLM clichés (click to toggle)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "data_collection_permissions": {
    "data_used": []
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{e3050897-ca45-4267-9197-95462684c8a9}",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
