{
  "manifest_version": 3,
  "name": "LLM Cliché Highlighter",
  "version": "1.0.0",
  "description": "Highlights LLM clichés on the current page; click again to remove. Port of Simon Willison's llm-cliche-highlighter (Apache-2.0).",
  "homepage_url": "https://github.com/hwasiti/llm-cliche-highlighter-extension",
  "action": {
    "default_title": "Highlight LLM clichés (click to toggle)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "llm-cliche-highlighter@wasiti14.gmail.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
